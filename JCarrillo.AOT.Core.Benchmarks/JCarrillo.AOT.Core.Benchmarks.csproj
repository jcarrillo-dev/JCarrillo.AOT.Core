<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <Authors>José Carrillo Serrano, Gemini (Google)</Authors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredCompilation>false</TieredCompilation>
    <OptimizationPreference>Speed</OptimizationPreference>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1707/CA1822: BenchmarkDotNet exige métodos [Benchmark] de instancia y los nombres con guion bajo son su convención de reporte -->
    <NoWarn>$(NoWarn);1591;JCA0001;JCA0002;JCA0003;CA1707;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JCarrillo.AOT.Core\JCarrillo.AOT.Core.csproj" />
  </ItemGroup>
</Project>
